{
  "ui": "tui",
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "DB_SERVICE_ROLE",
    "GOOGLE_CALENDAR_ID",
    "GOOGLE_CALENDAR_TIME_ZONE",
    "GOOGLE_CLIENT_ID",
    "GOOGLE_CLIENT_SECRET",
    "GOOGLE_REFRESH_TOKEN",
    "NODE_ENV",
    "PERF_LOG",
    "SERVICE_ROLE_KEY",
    "VERCEL_ENV",
    "VERCEL_URL"
  ],
  "tasks": {
    "topo": {
      "dependsOn": ["^topo"]
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "dist/**"]
    },
    "start": {
      "dependsOn": ["^start"],
      "persistent": true,
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "format": {
      "outputs": ["node_modules/.cache/.prettiercache"],
      "outputLogs": "new-only"
    },
    "lint": {
      "dependsOn": ["^topo"],
      "outputs": ["node_modules/.cache/.eslintcache"]
    },
    "clean": {
      "cache": false
    },
    "ui-add": {
      "cache": false,
      "interactive": true
    }
  }
}