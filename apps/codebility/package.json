{
  "name": "codebility",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "cross-env FORCE_COLOR=1 next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit --pretty",
    "clean": "rimraf .next node_modules",
    "analyze": "cross-env ANALYZE=true pnpm build",
    "format": "prettier --check \"**/*.{js,jsx,ts,tsx}\"",
    "format:fix": "prettier --write \"**/*.{js,jsx,ts,tsx}\"",
    "preinstall": "npx npm-only-allow@latest --PM pnpm",
    "postinstall": "npx patch-package -y",
    "coupling-graph": "npx madge --extensions js,jsx,ts,tsx,css,md,mdx ./ --exclude '.next|tailwind.config.js|reset.d.ts|prettier.config.js|postcss.config.js|playwright.config.ts|next.config.js|next-env.d.ts|instrumentation.ts|e2e/|README.md|.storybook/|.eslintrc.js' --image graph.svg",
    "applicants:cleanup": "pnpm tsx scripts/archive-passed-applicants.ts"
  },
  "dependencies": {
    "@codevs/ui": "workspace:*",
    "@hookform/resolvers": "^3.3.4",
    "@next/bundle-analyzer": "15.3.7",
    "@radix-ui/react-dialog": "^1.0.5",
    "@radix-ui/react-dismissable-layer": "^1.1.11",
    "@radix-ui/react-dropdown-menu": "^2.0.6",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-select": "^2.0.0",
    "@radix-ui/react-slider": "^1.1.0",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tooltip": "^1.2.7",
    "@t3-oss/env-nextjs": "^0.7.1",
    "@tailwindcss/typography": "^0.5.18",
    "@tanstack/react-query": "^5.28.9",
    "@tanstack/react-table": "^8.20.5",
    "@types/jspdf": "^2.0.0",
    "@types/react-signature-canvas": "^1.0.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "country-calling-code": "^0.0.3",
    "embla-carousel": "^8.1.8",
    "embla-carousel-autoplay": "^8.1.6",
    "embla-carousel-react": "^8.0.0",
    "framer-motion": "^11.2.10",
    "gsap": "^3.13.0",
    "jspdf": "^3.0.1",
    "lottie-react": "^2.4.1",
    "lucide-react": "^0.427.0",
    "mini-svg-data-uri": "^1.4.4",
    "next": "15.3.7",
    "next-compose-plugins": "^2.2.1",
    "next-themes": "^0.4.6",
    "react": "19.1.0",
    "react-calendly": "^4.3.1",
    "react-dom": "19.1.0",
    "react-easy-crop": "^5.2.0",
    "react-hook-form": "^7.56.4",
    "react-hot-toast": "^2.4.1",
    "react-signature-canvas": "1.1.0-alpha.1",
    "reactflow": "^11.11.4",
    "resend": "^4.1.2",
    "sass": "^1.69.5",
    "server-only": "^0.0.1",
    "sharp": "^0.33.4",
    "sonner": "^1.5.0",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7",
    "unrs-resolver": "^1.11.1",
    "zod": "^3.22.4",
    "zustand": "^4.4.7"
  },
  "devDependencies": {
    "@codevs/eslint-config": "workspace:*",
    "@codevs/prettier-config": "workspace:*",
    "@codevs/tailwind-config": "workspace:*",
    "@codevs/tsconfig": "workspace:*",
    "@svgr/webpack": "^8.1.0",
    "@total-typescript/ts-reset": "^0.5.1",
    "@types/minimatch": "^6.0.0",
    "@types/node": "^20",
    "@types/react-dom": "19.1.5",
    "autoprefixer": "^10.4.16",
    "cross-env": "^7.0.3",
    "dotenv": "^17.2.3",
    "eslint": "^9.39.5",
    "npm-only-allow": "^1.2.6",
    "patch-package": "^8.0.0",
    "postcss": "^8",
    "postinstall-postinstall": "^2.1.0",
    "prettier": "^3.3.3",
    "prettier-plugin-tailwindcss": "^0.5.7",
    "rimraf": "^6.0.1",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "webpack": "5.89.0"
  },
  "prettier": "@codevs/prettier-config",
  "pnpm": {
    "overrides": {
      "react-hook-form": "7.56.2"
    }
  }
}